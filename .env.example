# ===== 运行模式 =====
# local   : 纯 Python 几何引擎 + 预生成 GeoJSON 分片（无需 Docker，开箱即用）
# postgis : PostGIS 空间计算 + Martin MVT 瓦片（docker compose 生产模式）
SPATIAL_ENGINE=local
TILE_SOURCE=local
MARTIN_URL=http://localhost:3000

# ===== 数据库 =====
POSTGRES_PASSWORD=postgres123
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/wuhan_flood_gis
REDIS_URL=redis://localhost:6379/0

# ===== 大模型（AI 防汛调度 Copilot）=====
# 留空时自动降级为内置中文规则解析器，功能完整可用
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
